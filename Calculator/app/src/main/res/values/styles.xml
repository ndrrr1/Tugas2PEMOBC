<resources>
    <style name="Theme.Calculator" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Key">
        <item name="android:layout_width">64dp</item><item name="android:layout_height">52dp</item>
        <item name="android:textColor">@color/text</item><item name="android:textSize">21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_key</item><item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item><item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item><item name="android:soundEffectsEnabled">true</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Key.Operator" parent="Key">
        <item name="android:background">@drawable/bg_operator</item><item name="android:textColor">@color/accent</item>
    </style>
    <style name="Key.Utility" parent="Key"><item name="android:background">@drawable/bg_utility</item></style>
    <style name="Key.Science" parent="Key.Utility"><item name="android:textSize">16sp</item></style>
    <style name="Key.Equal" parent="Key">
        <item name="android:background">@drawable/bg_equal</item><item name="android:textColor">@color/accent_ink</item>
    </style>
    <style name="Key.Clear" parent="Key"><item name="android:background">@drawable/bg_clear</item><item name="android:textColor">@color/danger</item></style>
    <style name="Chip" parent="Key">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">42dp</item>
        <item name="android:textSize">12sp</item><item name="android:paddingLeft">14dp</item><item name="android:paddingRight">14dp</item>
    </style>
</resources>
